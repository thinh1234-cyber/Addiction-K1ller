{
  "manifest_version": 3,
  "name": "Addiction K1ller - Feed Blocker & DOM Inspector",
  "version": "2.1.0",
  "description": "Block distracting news feeds and custom websites while keeping Chat, Search, and Messages intact. Includes DOM picker, theme engine, and time analytics.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "idle",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/settings.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["scripts/content.js"],
      "css": ["styles/inject.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
