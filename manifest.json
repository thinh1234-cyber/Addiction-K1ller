{
  "manifest_version": 3,
  "name": "Kill Addiction - Feed Blocker & DOM Inspector",
  "version": "1.0.0",
  "description": "Block distracting news feeds on Facebook, YouTube, TikTok, Instagram & Threads while keeping Chat, Search, and Messages intact. Includes live DOM element picker.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.messenger.com/*",
    "*://*.youtube.com/*",
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*",
    "*://*.threads.net/*",
    "*://*.threads.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.youtube.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.threads.net/*",
        "*://*.threads.com/*"
      ],
      "js": ["scripts/content.js"],
      "css": ["styles/inject.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
